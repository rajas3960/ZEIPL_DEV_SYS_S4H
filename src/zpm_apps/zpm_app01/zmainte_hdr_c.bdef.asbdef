projection;
strict ( 1 );
use draft;
use side effects;

define behavior for ZMAINTE_HDR_C //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;

  use action PDF;
  use action UpdateItem;
  use action ExcelUpload;

  use association _item { create; with draft;}
}

define behavior for ZMAINTE_ITM_C //alias <alias_name>
{
  use update;
  use delete;

  use association _header { with draft; }
}