        { type: #FOR_ACTION, dataAction: 'Createresult', label: 'Create Result',position: 20 },
        { type: #FOR_ACTION, dataAction: 'updateresult', label: 'Update Result',position: 30 },
        { type: #FOR_ACTION, dataAction: 'UpdateUD', label: 'UD Code',position: 40 },
        { type: #FOR_ACTION, dataAction: 'PostInvoice', label: 'Park Debit Note',position: 50 } 
        ]}
