@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Manage Inspection Lot',
typeNamePlural: 'Manage Inspection Lot',
title: { type: #STANDARD, value: 'Inspectionlot' }
}}
@UI.createHidden: true
@UI.deleteHidden: true
annotate entity ZQM_C_INSP_HEAD
    with 
{
  @UI.facet: [ { id:              'Header',
