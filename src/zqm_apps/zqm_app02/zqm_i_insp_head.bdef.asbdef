managed implementation in class zbp_qm_i_insp_head unique;
strict ( 2 );
with draft;

define behavior for ZQM_I_INSP_HEAD alias InspHead
persistent table zqm_app01_db
draft table zqm_app01_dbd
lock master total etag Lastchangedat
authorization master ( instance )
etag master Lastchangedat
{
  create ( authorization : global );
  update(features : instance);
  delete(features : instance);
  field ( numbering : managed, readonly ) Uuid;
  field(readonly) Inspectionlot,Inspectiondate,Material,Materialdes,Inspectionlotqty,
                  Inspectionlottype,Plant,Purchaseorder,Purchaseorderitem,Materialdocument,
                  Materialdocumentitem,Materialdocumentyear,Companycode,Companycodename,
                  Plantname,Createindicator,Updateindicator,Udcodeindicator,Reference,
                  Postingdate,Supplierinvoice,Fiscalyear,Totalamt, Usagedecisioncode,Usagedecisiontext;
  association _InspResult { create; with draft;}

  draft action ( features : instance )Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;
  action( features : instance ) Createresult result [1] $self;
  action( features : instance ) updateresult result [1] $self;
  action( features : instance ) UpdateUD parameter ZQM_UD_PARAMETER result [1] $self;
  action( features : instance ) PostInvoice parameter ZQM_INVOICE_INP result [1] $self;
  action( features : instance ) UpInsp result [1] $self;

  side effects { action UpInsp
                affects $self , entity _InspResult;
                }
  mapping for zqm_app01_db corresponding;
}

define behavior for ZQM_I_INSP_RESULT alias InspResult
persistent table zqm_mic_db
draft table zqm_mic_dbd
lock dependent by _InspHead
authorization dependent by _InspHead
//etag master <field_name>
{
  update(features : instance);
  delete(features : instance);
  field ( readonly ) Uuid, Plangroup, Boocharacteristic,Inspectionlot,Masteric,Specification,Inspunit,Amtvalue;
  association _InspHead {with draft;}

  determination Update on modify { field Inspresultmeanvalue; }

  mapping for zqm_mic_db corresponding;
}