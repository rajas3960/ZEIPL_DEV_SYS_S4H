projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZQM_C_INSP_HEAD alias InspHead
{
  use create;
  use update;
  use delete;

  use action Createresult;
  use action updateresult;
  use action UpdateUD;
  use action PostInvoice;
  use action UpInsp;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _InspResult { create; with draft; }
}

define behavior for ZQM_C_INSP_RESULT alias InspResult
{
  use update;
  use delete;

  use association _InspHead { with draft; }
}