projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZQM_C_HEAD alias QMHeader
{
  use create;
  use update;
  use delete;

  use action GetMIC;
  use action UpInsp;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _ItemMIC { create; with draft; }
  use association _ItemSlab { with draft; }
}

define behavior for ZQM_C_MIC alias QMMic
{
  use update;
  use delete;

  use association _Header { with draft; }
  use association _ItemSlab { create; with draft; }
}

define behavior for ZQM_C_SLAB alias QMSlab
{
  use update;
  use delete;

  use association _Header { with draft; }
  use association _ItemMIC { with draft; }
}