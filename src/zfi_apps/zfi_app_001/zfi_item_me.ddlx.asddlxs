@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Debit Note',
typeNamePlural: 'Debit Note',
title: { type: #STANDARD, value: 'AccountingDocumentItem' } } }
@UI.createHidden: true
//@UI.updateHidden: true
@UI.deleteHidden: true
annotate entity ZFI_ITEM_PROJECTION_VIEW with
{
  @UI.facet: [ { id:              'Item',
                   purpose:         #STANDARD,
                   type:            #IDENTIFICATION_REFERENCE,
                   label:           'Standard Item',
                   position:        10 } ]

//  @UI:{ lineItem: [{ position: 10, label: 'Accounting Document' }],
//          identification: [{ position: 10, label: 'Accounting Document' }] }
//  @EndUserText.label: 'Accounting Document' 

 @UI: {
    lineItem: [
        { position: 10, label: 'Accounting Document' },
        { type: #FOR_ACTION, dataAction: 'MatdesInput',label: 'Material Details', position: 20, invocationGrouping: #CHANGE_SET }
    ],
    identification: [ { position: 10, label: 'Accounting Document' }]
 }
 @EndUserText.label: 'Accounting Document'
  AccountingDocument;
  //  LedgerGLLineItem;
  @UI:{ lineItem: [{ position: 20, label: 'Accounting Item' }],
          identification: [{ position: 20, label: 'Accounting Item' }] }
  @EndUserText.label: 'Accounting Item'
  AccountingDocumentItem;
  //  AccountingDocumentType;
  //  Plant;
