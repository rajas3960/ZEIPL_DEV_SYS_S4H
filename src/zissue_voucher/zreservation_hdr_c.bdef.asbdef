projection;
strict ( 2 );

define behavior for ZRESERVATION_HDR_C alias MainHeader
{
  use create;
  use update;
  use delete;

  use action PDF;

  use association _item { create; }
}

define behavior for ZRESERVATION_ITEM_C alias MainItem
{
  use update;
  use delete;

  use association _header;
}