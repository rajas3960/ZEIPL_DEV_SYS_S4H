@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Material Outward - Gate Pass',
typeNamePlural: 'Material Outward - Gate Passes',
title: { type: #STANDARD, value: 'Rgpnrpactualno' },
         description: { type: #STANDARD, value: 'Gptype' }  } }
annotate entity ZMM_APP1_RPV with
{
  @UI.facet: [ { id:              'Header',
                          purpose:         #STANDARD,
                          type:            #IDENTIFICATION_REFERENCE,
                          label:           'Gate Pass Detials',
                          position:        10 } ,
                        { id:              'Items',
                          purpose:         #STANDARD,
                          type:            #LINEITEM_REFERENCE,
                          label:           'Standard Material Line',
                          position:        20,
                          targetElement:   '_Item1'}]
                          
