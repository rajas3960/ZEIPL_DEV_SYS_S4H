@Metadata.layer: #CUSTOMER
annotate entity ZMM_APP1_IPV1 with
{
  @UI.facet: [ { id:              'Item',
                   purpose:         #STANDARD,
                   type:            #IDENTIFICATION_REFERENCE,
                   label:           'Standard Items',
                   position:        10 } ]
  @UI.hidden: true
  Uuid;
  @UI: { lineItem: [{ position: 10, label: 'Item No' }],
  identification: [{ position: 10, label: 'Item No'  }] }
  Itemno;
  @UI: { lineItem: [{ position: 20, label: 'Material Code' }],
  identification: [{ position: 20, label: 'Material Code'  }] }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_PRODUCTBYPLANT_VH', element: 'Product' },
     additionalBinding: [  {localElement: 'Maktx', element: 'Prodesc', usage: #RESULT },
                           {localElement: 'Uom', element: 'Baseunit', usage: #RESULT },
                           {localElement: 'Hsncode', element: 'Hsncode', usage: #RESULT },
                           {localElement: 'Netprice', element: 'Netprice', usage: #RESULT },
                           {localElement: 'plantname', element: 'PlantName', usage: #RESULT },
                           { localElement: 'Curky',element: 'Currency', usage: #RESULT },
                          {localElement: 'plant', element: 'Plant',usage: #FILTER_AND_RESULT } ]  } ]
//   @Search.defaultSearchElement: true                      
//   @Search.fuzzinessThreshold: 0.8     
  Matnr;
  
  @UI: { lineItem: [{ position: 30, label: 'Material Desc.' }],
  identification: [{ position: 30, label: 'Material Desc.'  }] }
//  @Search.fuzzinessThreshold: 0.8 
  Maktx;
  
  @UI: { lineItem: [{ position: 40, label: 'UOM' }],
  identification: [{ position: 40, label: 'UOM'  }] }
  Uom;
 
   @UI: { lineItem: [{ position: 50, label: 'Plant' }],
  identification: [{ position: 50, label: 'Plant'  }] }
  plant;
  
   @UI: { lineItem: [{ position: 60, label: 'Plant Name' }],
  identification: [{ position: 60, label: 'Plant Name'  }] }
  plantname;
 @UI: { lineItem: [{ position: 70, label: 'Storage Location' }],
  identification: [{ position: 70, label: 'Storage Location',importance: #HIGH }]}
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_StorageLocationStdVH',element: 'StorageLocation' },
  additionalBinding: [{ localElement: 'plant', element: 'Plant', usage: #FILTER }]
    }]
  Storagelocation;
  @UI: { lineItem: [{ position: 80, label: 'HSN/SAC Code' }],
  identification: [{ position: 80, label: 'HSN/SAC Code'  }] }
  Hsncode;
  @UI: { lineItem: [{ position: 90, label: 'Quantity',importance: #HIGH }],
  identification: [{ position: 90, label: 'Quantity',importance: #HIGH   }] }
  Quantity;
  @UI.hidden: true
  Curky;
  @UI: { lineItem: [{ position: 100, label: 'Item Value' }],
  identification: [{ position: 100, label: 'Item Value'  }] }
  Netprice;
  @UI: { lineItem: [{ position: 110, label: 'Total Amount' }],
  identification: [{ position: 110, label: 'Total Amount'  }] }
  Totvalue;
  @UI.hidden: true
  Rgpnrpactualno;
  @UI: { lineItem: [{ position: 120, label: 'Remark' }],
  identification: [{ position: 120, label: 'Remark'  }] }
  Remarks;
  @UI.hidden: true
  Mark;
  @UI.hidden: true
  Createdby;
  @UI.hidden: true
  Createdat;
  @UI.hidden: true
  Lastchangedby;
  @UI.hidden: true
  Lastchangedat;
  /* Associations */
