@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName: 'Upload',
    typeNamePlural: 'Uploads',
    title:       { type: #STANDARD, value: 'FileName' },
    description: { type: #STANDARD, value: 'StatusText' }
  },
  presentationVariant: [{ sortOrder: [{ by: 'CreatedAt', direction: #DESC }] }]
}
annotate entity ZC_MM_PO_TMUPL with
{
  @UI.facet: [
    { id: 'File',   purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
      label: 'Excel File', position: 10 },
    { id: 'Result', purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Result', label: 'Upload Result', position: 20 },
    { id: 'Admin',  purpose: #STANDARD, type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'Admin', label: 'Administrative Data', position: 30 }
  ]

  @UI.hidden: true
  UploadUuid;

  @UI: { identification: [{ position: 10 },
                          { type: #FOR_ACTION, dataAction: 'ExcelUpload',
                            label: 'Upload to Carrier Allocation', position: 10 }],
         lineItem:       [{ type: #FOR_ACTION, dataAction: 'ExcelUpload',
                            label: 'Upload to Carrier Allocation', position: 10 }] }
  @EndUserText.label: 'Excel File (.xlsx)'
  Attachment;

  @UI.hidden: true
  MimeType;

  @UI: { lineItem: [{ position: 20, importance: #HIGH }] }
  @EndUserText.label: 'File Name'
  FileName;

  @UI.hidden: true
  Status;

  @UI: { lineItem:   [{ position: 30, importance: #HIGH, criticality: 'StatusCriticality' }],
         fieldGroup: [{ qualifier: 'Result', position: 10, criticality: 'StatusCriticality' }] }
  @EndUserText.label: 'Status'
  StatusText;

  @UI.hidden: true
  StatusCriticality;

  @UI: { lineItem:   [{ position: 40 }],
         fieldGroup: [{ qualifier: 'Result', position: 20 }] }
  @EndUserText.label: 'Rows'
  RowsRead;

  @UI.fieldGroup: [{ qualifier: 'Result', position: 30 }]
  @EndUserText.label: 'Carriers Created'
  CarCreated;

  @UI.fieldGroup: [{ qualifier: 'Result', position: 40 }]
  @EndUserText.label: 'Carriers Updated'
  CarUpdated;

  @UI.fieldGroup: [{ qualifier: 'Result', position: 50 }]
  @EndUserText.label: 'Freight Orders Created'
  FoCreated;

  @UI.fieldGroup: [{ qualifier: 'Result', position: 60 }]
  @EndUserText.label: 'Freight Orders Updated'
  FoUpdated;

  @UI: { lineItem:   [{ position: 50 }],
         fieldGroup: [{ qualifier: 'Result', position: 70 }] }
  @EndUserText.label: 'Result'
  Message;

  @UI: { lineItem:   [{ position: 60 }],
         fieldGroup: [{ qualifier: 'Admin', position: 10 }] }
  CreatedBy;
  @UI: { lineItem:   [{ position: 70 }],
         fieldGroup: [{ qualifier: 'Admin', position: 20 }] }
  CreatedAt;
  @UI.fieldGroup: [{ qualifier: 'Admin', position: 30 }]
  LastChangedBy;
  @UI.fieldGroup: [{ qualifier: 'Admin', position: 40 }]
  LastChangedAt;

  @UI.hidden: true
  LocalLastChanged;
}