projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_SD_SO_TMCAR alias Carrier
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _FreightOrder { create; with draft; }
}

define behavior for ZC_SD_SO_TMFO alias FreightOrder
{
  use update;
  use delete;

  use association _Carrier { with draft; }
}