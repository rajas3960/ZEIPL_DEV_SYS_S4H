  identification : [{ position: 46, label: 'Quotation Qty' }]  }
  sqty;
    @UI: { lineItem: [{ position: 48, label: 'Quotation Rate' }],
  identification : [{ position: 48, label: 'Quotation Rate' }]  }
  NetPriceAmount;
  @UI: { lineItem: [{ position: 50, label: 'Total Quotation Net Value' }],
  identification : [{ position: 50, label: 'Total Quotation Net Value' }]  }
  NetAmount;
  @UI: { lineItem: [{ position: 60, label: 'Quotation Date' }],
  identification : [{ position: 60, label: 'Quotation Date' }]  }
  PurgDocPriceDate;
  @UI.hidden: true
  DocumentCurrency;
  @UI: { lineItem: [{ position: 70, label: 'Last Purchase Order' }],
  identification : [{ position: 70, label: 'Last Purchase Order' }]  }
  PurchaseOrder;
  @UI: { lineItem: [{ position: 70, label: 'Last PO Vendor' }],
  identification : [{ position: 70, label: 'Last PO Vendor' }]  }  
  lastpo_supplier;
  @UI: { lineItem: [{ position: 80, label: 'Last PO Creation Date' }],
  identification : [{ position: 80, label: 'Last PO Creation Date' }]  }
  CreationDate;
  @UI: { lineItem: [{ position: 90, label: 'Last PO  Amount' }],
  identification : [{ position: 90, label: 'Last PO  Amount' }]  }
  PoNetAmount;
  @UI: { lineItem: [{ position: 100, label: 'GRN Number' }],
