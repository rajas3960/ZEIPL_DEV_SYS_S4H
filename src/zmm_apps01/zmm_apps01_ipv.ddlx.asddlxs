@Metadata.layer: #PARTNER
@UI.presentationVariant: [{
    sortOrder: [{
        by: 'Compare',
        direction: #DESC
    }]
}]
annotate entity ZMM_APPS01_IPV with
{
  @UI.facet: [ { id:              'Item',
                    purpose:         #STANDARD,
                    type:            #IDENTIFICATION_REFERENCE,
                    label:           'Quotations',
                    position:        10 } ]

  @UI: {  lineItem:       [ { position: 05, label: 'Compare Status',criticality:'stuscrt' } ],
     identification: [ { position: 05, label: 'Compare Status'} ] }
  @UI.textArrangement: #TEXT_ONLY
  @UI.dataPoint: { qualifier: 'StatusData', title: 'Compare Status', criticality: 'stuscrt' }
