@Metadata.layer: #CUSTOMER
@UI: { headerInfo: {
typeName: 'Gate Entry - Apps',
typeNamePlural: 'Gate Entry - Apps',
title: { type: #STANDARD, value: 'Gateentryno' }
}}
annotate entity ZSD_C_GATEHEAD
    with 
{
  @UI.facet: [ { id:              'Header',
                      purpose:         #STANDARD,
                      type:            #IDENTIFICATION_REFERENCE,
                      label:           'Gate Entry Details',
                      position:        10 },
                      { id:              'SalesHead',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           'Order Details',
                      position:        20,
                      targetElement:   '_SalesHead'},
                      { id:              'SalesItems',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           'Order Item Details',
                      position:        30,
                      targetElement:   '_SalesItem'}]
@UI.hidden: true 
Uuid;
  @UI: {  lineItem:       [ { position: 05, label: 'Gate ID' } ],
        identification:   [ { position: 05, label: 'Gate ID' } ]}
        @EndUserText.label: 'Gate ID'
Gateentryid;
  @UI: {  lineItem:       [ { position: 08, label: 'Gate ID Date' } ],
