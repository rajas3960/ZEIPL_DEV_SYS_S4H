                                    distinctValues: true }] //this one for Dropdown option       
Gateentrytype;

  @UI: {  lineItem:       [ { position: 20, label: 'Gate Entry No' } ],
        identification:   [ { position: 20, label: 'Gate Entry No' },
        { type: #FOR_ACTION, dataAction: 'GateCheckIn', label: 'Gate CheckIn',position: 10 },
        { type: #FOR_ACTION, dataAction: 'SalesOrder', label: 'Sales Order',position: 20 },
        { type: #FOR_ACTION, dataAction: 'PRINT', label: 'QR Print Slip',position: 30 }
         ]}
        @EndUserText.label: 'Gate Entry No'
  @UI.selectionField: [{ position: 10 }]         
Gateentryno;
  @UI: {  lineItem:       [ { position: 30, label: 'Gate Entry Date' } ],
        identification:   [ { position: 30, label: 'Gate Entry Date' } ]}
        @EndUserText.label: 'Gate Entry Date' 
Gateentrydate;
  @UI: {  lineItem:       [ { position: 40, label: 'Gate Entry Time' } ],
