projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZSD_C_GATEHEAD //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action SalesOrder;
  use action PRINT;
  use action GateCheckIn;

  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;

  use association _SalesHead { create; with draft; }
  use association _SalesItem { create; with draft; }
}

define behavior for ZSD_C_SGATEHEAD //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}

define behavior for ZSD_C_SGATEITEM //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}