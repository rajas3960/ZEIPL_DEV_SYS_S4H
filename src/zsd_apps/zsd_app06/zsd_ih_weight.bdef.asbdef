managed implementation in class zbp_sd_ih_weight unique;
strict ( 1 );
with draft;

define behavior for ZSD_IH_WEIGHT alias WeightHead
persistent table zsd_app05_hdb
draft table zsd_app05_hdbd
with additional save
lock master total etag Lastchangedby
authorization master ( instance )
etag master Lastchangedby
{
  create ( authorization : global );
  update ( features : instance );
  delete ( features : instance );
  field ( readonly, numbering : managed ) Uuid;
  field ( readonly )Gateno, Gatenodes, Plant, Plantname,Gateentryid,Gateentryiddate,Cancelgateentry,
    Gateentryidtime,Gateentrytype,Gateentrytypetext,Gateentryno,Gateentrysequence,Gateentrydate,
    Gateentrytime,Transportid,Transportname,Vehicleno,Packingdetails,Dispinstrdetails,Contactdetails,Drivername,
    Driveraddress,Driverlicensenumber,Drivermobile,Remarks,Customer,Customername,Fromplace,Billingfrom,
    Consignee,   Billto,Broker,Doremark,Division,Attachment,Mimetype,Filename,Attachmentwt,Mimetypewt,Filenamewt,
    Weigmentindicator,    Weighmentindicator,Weighmentmcno,Weighmentmcndes,Weighmentdate,Weighmenttime,Weighuom,
    Tarewt,    Deliveryno,    Createdby,Createdat,Lastchangedby,Lastchangedat,Materialdocument,Materialdocumentyear,
    Picqtindicator,Gateentrystatus,Criticality;
  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare;

  action ( features : instance ) Weighmentslip result [1] $self;
  action ( features : instance ) CancelGateEntry result [1] $self;
  action ( features : instance ) AutoFetchWt parameter ZSD_AUTOWT_INP result [1] $self;
  action ( features : instance ) ManualFetchWt parameter ZSD_WEIGHT_INP result [1] $self;

  action ( features : instance ) CrtDelivery result [1] $self;
  action ( features : instance ) UpDlyheadertext result [1] $self;
  action ( features : instance ) PickingQty result [1] $self;
  action ( features : instance ) DeliveryPG result [1] $self;
  action ( features : instance ) TransExit result [1] $self;
  action ( features : instance ) ImagVald result [1] $self;

  determination PickQtyMdy on modify { field Picqtindicator; }

  side effects {
  action ManualFetchWt
    affects $self, entity _Item ; }

  association _Item { create; with draft;}


  mapping for zsd_app05_hdb corresponding;
}

define behavior for ZSD_II_WEIGHT alias WeightItem
persistent table zsd_app05_idb
draft table zsd_app05_idbd
lock dependent by _Head
authorization dependent by _Head
//etag master <field_name>
{
  update;
  delete;
  field ( readonly ) Uuid, Salesdocument, Salesitem;
  field ( readonly )Customer,Customername,Gateentryno,Plant,Plantname,Material, Materialdesc,Baseunit,
    Batch,Quantity,Remark,Tareweight,Grossweight,Netweight,Deliveryno,Deliveritem,Independentrequirementtype,
    Createdby,Createdat,Lastchangedby,Lastchangedat,OpenQty,Weighmentmcno,Weighmentmcndes;
  association _Head{ with draft;}

  action ( features : instance ) AutoFetchTWt parameter ZSD_AUTOWT_INP result [1] $self;
  action ( features : instance ) ManualFetchTWt parameter ZSD_WEIGHT_INP result [1] $self;
  action ( features : instance ) ImgCapture result [1] $self;

  mapping for zsd_app05_idb corresponding;
}