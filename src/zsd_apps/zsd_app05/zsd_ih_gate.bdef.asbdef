managed implementation in class zbp_sd_ih_gate unique;
strict ( 2 );
with draft;

define behavior for ZSD_IH_GATE alias GateHead
persistent table zsd_app05_hdb
draft table zsd_app05_hdbd
lock master total etag Lastchangedby
authorization master ( instance )
etag master Lastchangedby
{
  create ( authorization : global );
  update ( features : instance );
  delete ( features : instance );
  field ( readonly, numbering : managed ) Uuid;
  field ( readonly : update ) Gateno, Plant, Gateentrytype, Modeoftransport;
  field ( readonly ) Gateentryid, Gateentryiddate, Gateentryidtime, Gateentryno, Division, Modeoftransporttext, Transportname,
  Gateentrysequence, Gateentrytime, Gateentrydate, Customer, Customername, Createdat, Createdby, Lastchangedat, Lastchangedby,
  Attachment,Attachmentload,Filename,Filenameload,Mimetype,Mimetypeload,Fromplace,Billingfrom,Billto,Consignee,Broker,
  Cancelgateentry,Gateentrystatus,Criticality;
  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Resume;
  draft action Discard;
  draft determine action Prepare;

  action ( features : instance ) SalesOrder parameter ZSD_ORDER result [1] $self;
  action ( features : instance ) Print result [1] $self;
  action ( features : instance ) GateCheckIn result [1] $self;
  action ( features : instance ) CancelGateEntry result [1] $self;

  side effects
  {
    action SalesOrder
    affects $self, entity _Item; }
  determination headmodify on save { create; }

  association _Item { create; with draft; }

  mapping for zsd_app05_hdb corresponding;
}

define behavior for ZSD_II_GATE alias GateItem
persistent table zsd_app05_idb
draft table zsd_app05_idbd
lock dependent by _Header
authorization dependent by _Header
//etag master <field_name>
{
  update ( features : instance );
  delete ( features : instance );
  field ( readonly ) Uuid, Salesdocument, Salesitem
  , Customer, Customername, Plant, Plantname,
  Gateentryno, Material, Materialdesc, Baseunit, Quantity, Tareweight, Grossweight, Netweight,
  Createdat, Createdby, Lastchangedat, Lastchangedby,OpenQty,Independentrequirementtype;
  association _Header { with draft; }

  mapping for zsd_app05_idb corresponding;
}