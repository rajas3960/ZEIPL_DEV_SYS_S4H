@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName: 'Sales Contract',
  typeNamePlural: 'Sales Contracts',
  title: {
    type: #STANDARD,
    value: 'SalesContract'
  }
}

annotate entity ZSD_SC_REPORT_PV with
{
  @UI.facet: [
    {
      id: 'ContractItems',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Sales Contract Details',
      position: 10
    }
  ]

  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{ position: 10, label: 'Sales Contract No' }]
  @UI.identification: [{ position: 10, label: 'Sales Contract No' }]
  @EndUserText.label: 'Sales Contract No'
