projection;
strict ( 2 );
use draft;
//use side effects;
define behavior for ZSD_APPS08_PV alias hdr
{
  use create;
  use update;
  use delete;
  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _item { create; with draft; }
}

define behavior for ZSD_APPS08_IPV //alias <alias_name>
{

  use update;
  use delete;

  use association _hdr { with draft; }
}