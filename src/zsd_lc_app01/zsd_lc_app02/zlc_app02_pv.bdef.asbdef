projection;
strict ( 2 );
use draft;

define behavior for ZLC_APP02_PV alias _hdr
{
//  use create;
  use update;
//  use delete;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _litem { create; with draft; }
}

define behavior for ZLC_APP02_IPV alias _litem
{
  use update;
  use delete;

  use association _hdr { with draft; }
}