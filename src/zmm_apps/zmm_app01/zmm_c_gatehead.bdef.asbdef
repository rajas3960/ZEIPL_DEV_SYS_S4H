projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZMM_C_GATEHEAD //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action PRINT;
  use action Purchase;
  use action GateCheckIn;

  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;

  use association _POHEAD { create; with draft; }
  use association _POITEM { create; with draft; }
}

define behavior for ZMM_C_PGATEHEAD //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}

define behavior for ZMM_C_PGATEITEM //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}