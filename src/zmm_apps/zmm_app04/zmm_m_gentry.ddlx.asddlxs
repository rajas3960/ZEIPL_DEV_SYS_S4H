Experiredt;
  @EndUserText.label: 'Chasis No'
  @UI.identification: [ { position: 80 , label: 'Chasis No', qualifier: 'idSection1' } ]

Chaseno;
  @EndUserText.label: 'Address'
  @UI.identification: [ { position: 90 , label: 'Address', qualifier: 'idSection1' } ]

Address;
  @EndUserText.label: 'Helper Name'
  @UI.identification: [ { position: 95 , label: 'Helper Name', qualifier: 'idSection1' } ]
Helpername;
  @EndUserText.label: 'Engine No'
  @UI.identification: [ { position: 97 , label: 'Engine No', qualifier: 'idSection1' } ]
Engineno;
  @EndUserText.label: 'Gate ID'
  @UI.identification: [ { position: 100 , label: 'Gate ID', qualifier: 'idSection1' } ]
  @UI.lineItem: [ { position: 30 , label: 'Gate ID'} ]
  @UI.selectionField: [{ position: 20 }]
Gateentryid;
  @EndUserText.label: 'Gate ID Date'
  @UI.identification: [ { position: 110 , label: 'Gate ID Date', qualifier: 'idSection1' } ]
  @UI.lineItem: [ { position: 40 , label: 'Gate ID Date'} ]
  @UI.selectionField: [{ position: 30 }]
  @Consumption.filter:{ selectionType: #INTERVAL,multipleSelections: false } 
