@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: { typeName: 'Incoming Gate Entry - Security Apps',
                typeNamePlural: 'Incoming Gate Entry',
                title: { type: #STANDARD, label: 'Incoming Gate Entry', value: 'GateIDName' },
                            description: { value: 'Gateentryid' } } }
@UI.deleteHidden: true                            
annotate entity ZMM_C_GENTRY
    with 
{
  @UI.facet: [ {
                label: 'Inward Entry - Vehicle Details', 
                id: 'GeneralInfo', 
                purpose: #STANDARD, 
                position: 10 , 
                type: #IDENTIFICATION_REFERENCE,
                targetQualifier: 'idSection1'
                }, 
                {
                label: 'Document Information', 
                id: 'invoiceInfo', 
                purpose: #STANDARD, 
                position: 15 , 
                type: #IDENTIFICATION_REFERENCE,
                targetQualifier: 'idSection2'
                 },
                 
                        { id: 'GateIDSts', purpose: #HEADER, type: #DATAPOINT_REFERENCE,
                          position: 10, targetQualifier: 'GateIDSt' },
                        { id: 'CrtSts', purpose: #HEADER, type: #DATAPOINT_REFERENCE,
                          position: 20, targetQualifier: 'UserSt' },
                        { id: 'Crtdate', purpose: #HEADER, type: #DATAPOINT_REFERENCE,
                          position: 30, targetQualifier: 'Cdate' }
                ]
@UI.hidden: true                
Uuid;
  @EndUserText.label: 'Gate No'
  @UI.identification: [ { position: 05 , label: 'Gate No', qualifier: 'idSection1' } ]
//  { type: #FOR_ACTION, dataAction: 'PRINT', label: 'QR Print',position: 10 } ]
  @UI.lineItem: [ { position: 05 , label: 'Gate No'} ]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZMMGATE_NOVH', element: 'Gateno' },
  additionalBinding: [{localElement: 'Gatenodes', element: 'Gatenodes'}]          }]
Gateno;
  @EndUserText.label: 'Plant'
  @UI.identification: [ { position: 10 , label: 'Plant', qualifier: 'idSection1' } ]
  @UI.lineItem: [ { position: 10 , label: 'Plant'} ]
  @UI.selectionField: [{ position: 10 }]
  @Consumption.valueHelpDefinition: [ { entity: { name: 'I_Plant', element: 'Plant' },
  additionalBinding: [{localElement: 'Plantname', element: 'PlantName'}]          } ]
  @UI.hidden: true  
Plant;

  @EndUserText.label: 'Series'
  @UI.identification: [ { position: 15 , label: 'Series', qualifier: 'idSection1' } ]
  @UI.lineItem: [ { position: 20 , label: 'Series'} ]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZMMGATE_SERIES_VH', element: 'value_low' },distinctValues: true }]     
Gateentryseries;

  @EndUserText.label: 'Trasporter Id'
  @UI.identification: [ { position: 17 , label: 'Trasporter Id', qualifier: 'idSection1' } ]
  @UI.lineItem: [ { position: 50 , label: 'Trasporter Id'} ]
  @Consumption.valueHelpDefinition: [ { entity: { name: 'ZMM_BP_ZTRP_VH', element: 'Transporterid' },
  additionalBinding: [ { localElement: 'Trasportername', element: 'Transportername', usage: #RESULT } ]   } ]
  
Trasporterid;
  @EndUserText.label: 'Vehicle No'
  @UI.identification: [ { position: 20 , label: 'Vehicle No', qualifier: 'idSection1' } ]
  @UI.lineItem: [ { position: 60 , label: 'Vehicle No'} ]
Vehicleno;
  @EndUserText.label: 'Vehicle Type'
  @UI.identification: [ { position: 30 , label: 'Vehicle Type', qualifier: 'idSection1' } ]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZMM_VEHICLE_VH', element: 'value_low' },distinctValues: true }]     
Vehicletype;
  @EndUserText.label: 'Driver Name'
  @UI.identification: [ { position: 40 , label: 'Driver Name', qualifier: 'idSection1' } ]

Drivername;
  @EndUserText.label: 'Mobile No'
  @UI.identification: [ { position: 50 , label: 'Mobile No', qualifier: 'idSection1' } ]

Mobile;
  @EndUserText.label: 'License No'
  @UI.identification: [ { position: 60 , label: 'License No', qualifier: 'idSection1' } ]

Licenseno;
  @EndUserText.label: 'Expire Date'
