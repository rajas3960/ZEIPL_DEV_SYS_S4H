@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: { typeName: 'Inward Entry - Apps',
                typeNamePlural: 'Inward Entry - Apps',
                title: { type: #STANDARD, label: 'Inward Team Entry - Apps', value: 'GateEntryStatus' },
                            description:{ value: 'Gateentryno' } } }
//@UI.deleteHidden: true 
@UI.createHidden: true               
annotate entity ZMM_CH_INVENTRY
    with 
{
  @UI.facet: [ {
                id: 'GeneralInfo', 
                isSummary: true,                
                label: 'Inward Entry - Details', 
                type: #COLLECTION,
                
                purpose: #STANDARD 
                } , 
               { type: #FIELDGROUP_REFERENCE, targetQualifier: 'idSection1', parentId: 'GeneralInfo',
                position: 10,label: 'Gate Entry - Details',id: 'idSection1'},
               { type: #FIELDGROUP_REFERENCE, targetQualifier: 'idSec2', parentId: 'GeneralInfo',
                position: 15,label: 'Vehicle - Information',id: 'idSec2'},
//               { type: #FIELDGROUP_REFERENCE, targetQualifier: 'idSec3', parentId: 'GeneralInfo',
//                position: 20,label: 'Goods Receipts',id: 'idSec3'},
                                                 
                {
                label: 'Document Information', 
                id: 'invoiceInfo', 
                purpose: #STANDARD, 
                position: 12 , 
                type: #IDENTIFICATION_REFERENCE,
                targetQualifier: 'idSection2'
                 },
                      { id:              'POItems',
                      purpose:         #STANDARD,
                      type:            #LINEITEM_REFERENCE,
                      label:           'Order Item Details',
                      position:        25,
                      targetElement:   '_Item'},
                      
                        { id: 'ChInSts', purpose: #HEADER, type: #DATAPOINT_REFERENCE,
                          position: 10, targetQualifier: 'ChISts' },
                        { id: 'CrtSts', purpose: #HEADER, type: #DATAPOINT_REFERENCE,
                          position: 20, targetQualifier: 'UserSt' }
                ]
                
  @EndUserText.label: 'GateID No'
  @UI.lineItem: [ { position: 10 , label: 'GateID No'} ]
  @UI.identification: [ { position: 10 , label: 'GateID No' } ,
        { type: #FOR_ACTION, dataAction: 'Purchase', label: 'PO',position: 10 },
        { type: #FOR_ACTION, dataAction: 'GateCheckIn', label: 'Gate CheckIn',position: 20 }, 
//        { type: #FOR_ACTION, dataAction: 'MigoPost', label: 'GR Post',position: 15 },        

        { type: #FOR_ACTION, dataAction: 'GateSlipForm', label: 'Gate Entry Slip',position: 25 }]        
//        { type: #FOR_ACTION, dataAction: 'WeightScrn', label: 'Weighment Screen',position: 30 }

  @UI.selectionField: [{ position: 30 }]
  @UI.fieldGroup: [ { position: 10,  qualifier: 'idSection1', importance: #HIGH } ]    
Gateentryid;
  @EndUserText.label: 'Gate Entry No'
  @UI.lineItem: [ { position: 20 , label: 'Gate Entry No'} ]
  @UI.identification: [ { position: 20 , label: 'Gate Entry No' } ]

  @UI.selectionField: [{ position: 20 }]
  @UI.fieldGroup: [ { position: 20,  qualifier: 'idSection1', importance: #HIGH } ]    
