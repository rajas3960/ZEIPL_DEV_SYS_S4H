  @EndUserText.label: 'Gate Entry Date'
  @UI.lineItem: [ { position: 30 , label: 'Gate Entry Date'} ]
  @UI.identification: [ { position: 30 , label: 'Gate Entry Date' } ]

  @UI.fieldGroup: [ { position: 30,  qualifier: 'idSection1', importance: #HIGH } ]      
Gateentrydate;
  @EndUserText.label: 'Gate Entry Time'
  @UI.lineItem: [ { position: 40 , label: 'Gate Entry Time'} ]
  @UI.identification: [ { position: 40 , label: 'Gate Entry Time' } ]

  @UI.fieldGroup: [ { position: 40,  qualifier: 'idSection1', importance: #HIGH } ]      
