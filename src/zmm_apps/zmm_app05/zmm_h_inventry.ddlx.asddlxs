  @UI.identification: [ { position: 50 , label: 'Series' } ]
  @UI.fieldGroup: [ { position: 50,  qualifier: 'idSection1', importance: #HIGH } ]    
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZMMGATE_SERIES_VH', element: 'value_low' },distinctValues: true }]     
