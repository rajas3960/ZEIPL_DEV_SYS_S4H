projection;
strict ( 2 );
use draft;

define behavior for ZMM_CH_GRN alias Head
{
  use create;
  use update;
  use delete;

  use action MigoPost;
  use action InbDelivery;

  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZMM_CI_GRN //alias <alias_name>
{
  use update;
  use delete;

  use association _Head { with draft; }
}